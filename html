<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>테런 염색코드 변환기</title>
    <style>
        :root {
            --primary-color: #2c3e50;
            --accent-color: #3498db;
            --bg-color: #f8f9fa;
            --card-bg: #ffffff;
        }
        body {
            font-family: 'Pretendard', 'Malgun Gothic', sans-serif;
            background-color: var(--bg-color);
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .container {
            background-color: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            max-width: 900px;
            width: 100%;
            overflow: hidden;
        }
        .header {
            background-color: var(--primary-color);
            color: white;
            text-align: center;
            padding: 20px;
        }
        .header h1 {
            margin: 0;
            font-size: 22px;
        }
        .color-slots {
            display: flex;
            padding: 25px;
            gap: 20px;
        }
        .slot {
            flex: 1;
            background: #fdfdfd;
            border: 1px solid #e1e4e8;
            border-radius: 8px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .slot-title {
            text-align: center;
            font-weight: 700;
            color: var(--primary-color);
            font-size: 15px;
            border-bottom: 2px solid #f1f2f6;
            padding-bottom: 8px;
        }
        .input-box input {
            width: 100%;
            box-sizing: border-box;
            padding: 10px;
            font-size: 14px;
            text-align: center;
            border: 2px dashed #b2bec3;
            border-radius: 6px;
            background-color: #fbfcff;
            outline: none;
        }
        .input-box input:focus {
            border-color: var(--accent-color);
        }
        .result-box {
            display: flex;
            justify-content: space-between;
            background-color: #f1f2f6;
            border-radius: 6px;
            padding: 12px 8px;
        }
        .result-item {
            text-align: center;
            flex: 1;
        }
        .result-item span {
            display: block;
            font-size: 10px;
            color: #7f8c8d;
            margin-bottom: 2px;
            font-weight: bold;
        }
        .result-item strong {
            font-size: 20px;
            color: var(--primary-color);
        }
        /* 색상 미리보기 박스 스타일 */
        .color-preview {
            width: 100%;
            height: 40px;
            border-radius: 6px;
            border: 1px solid #dcdde1;
            background-color: #ffffff;
            transition: background-color 0.2s;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>테런 염색코드 변환기</h1>
    </div>
    
    <div class="color-slots">
        <!-- 첫 번째 슬롯 -->
        <div class="slot">
            <div class="slot-title">색상 1</div>
            <div class="input-box">
                <input type="text" id="raw-input-1" placeholder="HSV 또는 HEX 붙여넣기" oninput="parseAndCalculate(this.value, 1)">
            </div>
            <div class="result-box">
                <div class="result-item"><span>HUE</span><strong id="res-h-1">-</strong></div>
                <div class="result-item"><span>SAT</span><strong id="res-s-1">-</strong></div>
                <div class="result-item"><span>VAL</span><strong id="res-v-1">-</strong></div>
            </div>
            <div class="color-preview" id="preview-1"></div>
        </div>

        <!-- 두 번째 슬롯 -->
        <div class="slot">
            <div class="slot-title">색상 2</div>
            <div class="input-box">
                <input type="text" id="raw-input-2" placeholder="HSV 또는 HEX 붙여넣기" oninput="parseAndCalculate(this.value, 2)">
            </div>
            <div class="result-box">
                <div class="result-item"><span>HUE</span><strong id="res-h-2">-</strong></div>
                <div class="result-item"><span>SAT</span><strong id="res-s-2">-</strong></div>
                <div class="result-item"><span>VAL</span><strong id="res-v-2">-</strong></div>
            </div>
            <div class="color-preview" id="preview-2"></div>
        </div>

        <!-- 세 번째 슬롯 -->
        <div class="slot">
            <div class="slot-title">색상 3</div>
            <div class="input-box">
                <input type="text" id="raw-input-3" placeholder="HSV 또는 HEX 붙여넣기" oninput="parseAndCalculate(this.value, 3)">
            </div>
            <div class="result-box">
                <div class="result-item"><span>HUE</span><strong id="res-h-3">-</strong></div>
                <div class="result-item"><span>SAT</span><strong id="res-s-3">-</strong></div>
                <div class="result-item"><span>VAL</span><strong id="res-v-3">-</strong></div>
            </div>
            <div class="color-preview" id="preview-3"></div>
        </div>
    </div>
</div>

<script>
    function parseAndCalculate(inputValue, index) {
        const previewBox = document.getElementById('preview-' + index);

        if (!inputValue || !inputValue.trim()) {
            resetResult(index);
            return;
        }

        const val = inputValue.trim();
        const isHsvFormat = val.toLowerCase().includes('hsv');
        const hexRegex = /(?:#)([0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})\b|^([0-9A-Fa-f]{6})$/;
        const hasHexPattern = hexRegex.test(val);

        // 1. HEX 코드 처리
        if (!isHsvFormat && (val.includes('#') || hasHexPattern)) {
            let hexStr = val.replace(/[^0-9A-Fa-f]/gi, ''); 
            if (hexStr.length >= 6) {
                hexStr = hexStr.substring(0, 6);
            } else if (hexStr.length === 3) {
                hexStr = hexStr.split('').map(function(c) { return c + c; }).join('');
            } else {
                resetResult(index);
                return;
            }

            let r = parseInt(hexStr.substring(0, 2), 16) / 255;
            let g = parseInt(hexStr.substring(2, 4), 16) / 255;
            let b = parseInt(hexStr.substring(4, 6), 16) / 255;

            let max = Math.max(r, g, b), min = Math.min(r, g, b);
            let h = 0, s = 0, v = max;
            let d = max - min;
            s = max === 0 ? 0 : d / max;

            if (max !== min) {
                if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
                else if (max === g) h = (b - r) / d + 2;
                else h = (r - g) / d + 4;
                h /= 6;
            }

            document.getElementById('res-h-' + index).innerText = Math.round(h * 360 * (512 / 360));
            document.getElementById('res-s-' + index).innerText = Math.round(s * 100 * 5.12);
            document.getElementById('res-v-' + index).innerText = Math.round(v * 100 * 5.12);
            
            // 색상 미리보기 박스 적용
            previewBox.style.backgroundColor = '#' + hexStr;
            return;
        }

        // 2. HSV 코드 처리
        const numbers = val.match(/\d+(\.\d+)?/g);
        if (numbers && numbers.length >= 3) {
            const h = parseFloat(numbers[0]);
            const s = parseFloat(numbers[1]);
            const v = parseFloat(numbers[2]);
            
            document.getElementById('res-h-' + index).innerText = Math.round(h * (512 / 360));
            document.getElementById('res-s-' + index).innerText = Math.round(s * 5.12);
            document.getElementById('res-v-' + index).innerText = Math.round(v * 5.12);

            // HSV를 HEX로 변환하여 미리보기 색상 적용
            let rgbColor = hsvToRgb(h / 360, s / 100, v / 100);
            previewBox.style.backgroundColor = rgbToHex(rgbColor.r, rgbColor.g, rgbColor.b);
            return;
        }

        resetResult(index);
    }

    function resetResult(index) {
        document.getElementById('res-h-' + index).innerText = '-';
        document.getElementById('res-s-' + index).innerText = '-';
        document.getElementById('res-v-' + index).innerText = '-';
        document.getElementById('preview-' + index).style.backgroundColor = '#ffffff';
    }

    // 보조 함수: HSV -> RGB 변환
    function hsvToRgb(h, s, v) {
        let r, g, b, i, f, p, q, t;
        i = Math.floor(h * 6);
        f = h * 6 - i;
        p = v * (1 - s);
        q = v * (1 - f * s);
        t = v * (1 - (1 - f) * s);
        switch (i % 6) {
            case 0: r = v, g = t, b = p; break;
            case 1: r = q, g = v, b = p; break;
            case 2: r = p, g = v, b = t; break;
            case 3: r = p, g = q, b = v; break;
            case 4: r = t, g = p, b = v; break;
            case 5: r = v, g = p, b = q; break;
        }
        return { r: Math.round(r * 255), g: Math.round(g * 255), b: Math.round(b * 255) };
    }

    // 보조 함수: RGB -> HEX 변환
    function rgbToHex(r, g, b) {
        return "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }
</script>

</body>
</html>
